{
  "name": "rufocusing-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "models": "node scripts/prepare-models.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "local:configure": "node scripts/configure-local.mjs",
    "build:release": "node scripts/check-release.mjs && npm run models && npm run build",
    "test:integration": "node --test tests/api.integration.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/supabase-js": "2.57.4",
    "@mediapipe/tasks-vision": "0.10.32"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "@playwright/test": "^1.55.0",
    "@electric-sql/pglite": "^0.3.14"
  }
}
